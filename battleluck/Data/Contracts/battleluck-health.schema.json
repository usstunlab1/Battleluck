{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battleluck.local/contracts/battleluck-health.schema.json",
  "title": "BattleLuck Health Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractName",
    "schemaVersion",
    "producer",
    "producerVersion",
    "status",
    "initialized",
    "worldReady",
    "generatedAtUtc",
    "expiresAtUtc"
  ],
  "properties": {
    "contractName": { "const": "battleluck.health" },
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "producer": { "const": "BattleLuck" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["starting", "ready", "degraded", "stopping", "unavailable"] },
    "initialized": { "type": "boolean" },
    "worldReady": { "type": "boolean" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  }
}
